{
  "name": "@cryptobot-labs/executor",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1097.0",
    "@aws-sdk/client-secrets-manager": "3.1097.0",
    "@cryptobot-labs/trading-core": "workspace:*",
    "@cryptobot-labs/weex-client": "workspace:*",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "esbuild": "0.28.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
