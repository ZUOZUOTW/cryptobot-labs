# Keep true for the safe product preview. Set false only in a controlled formal environment.
DEMO_MODE=true
PUBLIC_ORIGIN=https://app.example.com
# transition: current login + manual API; dual: also enable WEEX OAuth;
# oauth-only: disable legacy login/manual API after the identity rollout is complete.
WEEX_AUTH_STAGE=transition

# Supabase Auth (publishable key only; never place service_role/secret keys in browser variables).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Generate at least 32 random bytes and store only in the deployment secret manager.
AUTH_COOKIE_SECRET=replace_with_at_least_32_random_bytes
SUPABASE_DATABASE_URL=postgresql://server-only-connection-string

# Netlify -> fixed-IP executor handoff. Do not put WEEX or KMS secrets in Netlify.
EXECUTOR_API_ORIGIN=https://api.example.com
EXECUTOR_HANDOFF_SECRET=replace_with_at_least_32_random_bytes
# Intentionally public: shown to users who must allow-list the executor.
NEXT_PUBLIC_EXECUTOR_EGRESS_IP=203.0.113.10

# AWS executor only. These values must live in AWS Secrets Manager, not Netlify.
WEEX_BROKER_ID=WEEX111162
WEEX_CLIENT_ID=replace_me
WEEX_CLIENT_SECRET=replace_me
WEEX_OAUTH_REDIRECT_URI=https://api.example.com/oauth/weex/callback
EXPECTED_EGRESS_IP=203.0.113.10
AWS_REGION=ap-northeast-1
AWS_KMS_KEY_ID=arn:aws:kms:ap-northeast-1:123456789012:key/replace_me
EXECUTOR_SHARD_ID=exec_replace_with_random_identifier
LIVE_TRADING_ENABLED=false
