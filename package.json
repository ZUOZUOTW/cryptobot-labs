    "jszip": "^3.10.1",
    "next": "16.2.12",
    "postgres": "3.4.8",
    "qrcode": "^1.5.4",
    "quickjs-emscripten-core": "0.32.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.7.0"
